@{
    ViewData["Title"] = "Công việc nhóm";
    ViewData["Description"] = "Danh sách công việc nhóm giúp bạn quản lý, phân công và theo dõi tiến độ công việc nhóm hiệu quả trong hệ thống quản lý công việc của chúng tôi.";
    ViewData["Keywords"] = "Công việc nhóm, Quản lý công việc nhóm, Phân công công việc, Quản lý nhóm, Group tasks, Team management";
    ViewData["Author"] = "Nhóm 14, Trường Đại học Mở Hà Nội, Lập trình web nâng cao";
    ViewData["Robots"] = "index, follow";

    Layout = "_SimpleLayout";
}

@inject WebNC_BTL_QLCV.Repositories.IUserRepository UserRepo

@model IEnumerable<GroupTask>

<link rel="stylesheet" href="~/css/GroupTask_List.css" />

<div class="task-layout-wrapper">

    <!-- Button to toggle filter sidebar on small screens -->
    <button id="filter-toggle-btn" class="btn btn-primary d-md-none mb-3">
        <i class="fas fa-filter"></i> Bộ lọc
    </button>

    <!-- Sidebar bộ lọc -->
    <div id="filter-sidebar-wrapper" class="filter-sidebar d-none">
        <h4>Lọc công việc</h4>
        <br />
        <h5>Trạng thái</h5>
        <button class="btn btn-outline-primary btn-filter-status" data-status="Chưa hoàn thành">Chưa hoàn thành</button>
        <button class="btn btn-outline-warning btn-filter-status" data-status="Đang thực hiện">Đang thực hiện</button>
        <button class="btn btn-outline-success btn-filter-status" data-status="Đã hoàn thành">Đã hoàn thành</button>
        <br />
        <br />
        <h5>Thời hạn</h5>
        <button class="btn btn-outline-info" id="btn-due-3">Kết thúc trong 3 ngày</button>
        <button class="btn btn-outline-info" id="btn-due-7">Kết thúc trong 7 ngày</button>
        <br />
        <br />
        <h5>Công việc cá nhân</h5>
        <button class="btn btn-outline-success" id="btn-my-tasks">Công việc của tôi</button>
        <br />
        <br />
        <button class="btn btn-outline-secondary" id="btn-reset">Đặt lại</button>
        <br />
        <br />
        <!-- Close button, visible only on small screens -->
        <button id="filter-close-btn" class="btn btn-danger d-md-none">Đóng</button>
    </div>


    <!-- Button to toggle statistics sidebar on small screens -->
    <button id="stats-toggle-btn" class="btn btn-primary d-md-none mb-3">
        <i class="fas fa-chart-bar"></i> Thống kê
    </button>

    <!-- Sidebar thống kê -->
    <div id="stats-sidebar-wrapper" class="stats-sidebar d-none">
        <div class="grouptask">
            <h2>Thống kê công việc của nhóm</h2>
            <div class="row justify-content-center">
                <div class="col-md-12">
                    <ul class="list-group mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Tổng số công việc
                            <span class="badge badge-primary badge-pill">@ViewBag.TotalTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Đã hoàn thành
                            <span class="badge badge-success badge-pill">@ViewBag.CompletedTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Đang thực hiện
                            <span class="badge badge-warning badge-pill">@ViewBag.InProgressTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Chưa hoàn thành
                            <span class="badge badge-danger badge-pill">@ViewBag.NotStartedTasks</span>
                        </li>
                    </ul>
                    <!-- Thanh phần trăm cho công việc nhóm -->
                    <div class="progress mt-2" style="height: 30px; position: relative;">
                        @{
                            double total = @ViewBag.TotalTasks > 0 ? @ViewBag.TotalTasks : 1; // Tránh chia cho 0
                            double completedPercent = Math.Round((double)@ViewBag.CompletedTasks / total * 100, 2);
                            double inProgressPercent = Math.Round((double)@ViewBag.InProgressTasks / total * 100, 2);
                            double notStartedPercent = Math.Round((double)@ViewBag.NotStartedTasks / total * 100, 2);
                        }
                        <div class="progress-bar bg-success" role="progressbar" style="width: @completedPercent%;" aria-valuenow="@completedPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@completedPercent%</span>
                        </div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @inProgressPercent%;" aria-valuenow="@inProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@inProgressPercent%</span>
                        </div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @notStartedPercent%;" aria-valuenow="@notStartedPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@notStartedPercent%</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="grouptask">
            <h2>Thống kê công việc của tôi</h2>
            <div class="row justify-content-center">
                <div class="col-md-12">
                    <ul class="list-group mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Tổng số công việc
                            <span class="badge badge-primary badge-pill">@ViewBag.PersonalTotalTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Đã hoàn thành
                            <span class="badge badge-success badge-pill">@ViewBag.PersonalCompletedTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Đang thực hiện
                            <span class="badge badge-warning badge-pill">@ViewBag.PersonalInProgressTasks</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Chưa hoàn thành
                            <span class="badge badge-danger badge-pill">@ViewBag.PersonalNotStartedTasks</span>
                        </li>
                    </ul>

                    <!-- Thanh phần trăm cho công việc cá nhân -->
                    <div class="progress mt-2" style="height: 30px; position: relative;">
                        @{
                            double personalTotal = @ViewBag.PersonalTotalTasks > 0 ? @ViewBag.PersonalTotalTasks : 1; // Tránh chia cho 0
                            double personalCompletedPercent = Math.Round((double)@ViewBag.PersonalCompletedTasks / personalTotal * 100, 2);
                            double personalInProgressPercent = Math.Round((double)@ViewBag.PersonalInProgressTasks / personalTotal * 100, 2);
                            double personalNotStartedPercent = Math.Round((double)@ViewBag.PersonalNotStartedTasks / personalTotal * 100, 2);
                        }
                        <div class="progress-bar bg-success" role="progressbar" style="width: @personalCompletedPercent%;" aria-valuenow="@personalCompletedPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@personalCompletedPercent%</span>
                        </div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @personalInProgressPercent%;" aria-valuenow="@personalInProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@personalInProgressPercent%</span>
                        </div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @personalNotStartedPercent%;" aria-valuenow="@personalNotStartedPercent" aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-label">@personalNotStartedPercent%</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- Close button, visible only on small screens -->
        <button id="stats-close-btn" class="btn btn-danger d-md-none">Đóng</button>
    </div>

    <div class="task-main-content">
        <div class="grouptask">
            <a class="btn-GroupTaskFileList" asp-action="GroupTaskFileList" asp-controller="GroupTaskFile" asp-route-taskid="@Context.Session.GetInt32("ParentGroupTaskId")">Xem danh sách tài liệu công việc</a>
            
            @if (ViewBag.IsLeader)
            {
                <a class="btn-ReportListByParentTask" asp-action="ReportListByParentTask" asp-controller="ReportTaskFile" asp-route-parentTaskId="@Context.Session.GetInt32("ParentGroupTaskId")">Xem danh sách báo cáo công việc</a>
                <a class="btn-MemberTaskStats" asp-action="MemberTaskStats">Xem danh sách thống kê công việc</a>
            }
            

            <div class="grouptask">
                <h2>Danh sách công việc nhóm của công việc cha: @Context.Session.GetString("ParentGroupTaskName")</h2>

                @if (ViewBag.IsLeader)
                {
                    <a class="btn-create" asp-action="Create">Thêm công việc mới</a>
                }

                <div class="task-container">
                    @foreach (var task in Model)
                    {
                        <div class="task-card @GetPriorityClass(task.PriorityLevel)" id="task-card-@task.GroupTaskID" data-status="@task.GroupTaskStatus" data-user-id="@task.UserID"
                             data-enddate="@task.EndDate.ToString("yyyy-MM-dd")">
                            <h3 class="task-name">@task.GroupTaskName</h3>
                            <p class="task-description">@task.GroupTaskDescription</p>
                            <p class="task-status">
                                @{
                                    string statusClass;
                                    switch (task.GroupTaskStatus)
                                    {
                                        case "Đã hoàn thành": statusClass = "text-success"; break;
                                        case "Chưa hoàn thành": statusClass = "text-danger"; break;
                                        case "Đang thực hiện": statusClass = "text-warning"; break;
                                        default: statusClass = "text-secondary"; break;
                                    }
                                }
                                <span class="@statusClass">@task.GroupTaskStatus</span>
                            </p>
                            <p class="task-priority">
                                @{
                                    string priorityClass;
                                    switch (task.PriorityLevel)
                                    {
                                        case "Thấp": priorityClass = "text-success"; break;
                                        case "Trung bình": priorityClass = "text-warning"; break;
                                        case "Cao": priorityClass = "text-danger"; break;
                                        case "Khẩn cấp": priorityClass = "priority-critical"; break;
                                        default: priorityClass = "text-secondary"; break;
                                    }
                                }
                                <span class="@priorityClass">Độ ưu tiên: @task.PriorityLevel</span>
                            </p>
                            <p class="task-dates">
                                <strong>Bắt đầu:</strong> @task.StartDate <br>
                                <strong>Kết thúc:</strong> @task.EndDate
                            </p>

                            @{
                                var groupMembers = ViewBag.GroupMembers as List<GroupMember>;
                                var member = groupMembers?.FirstOrDefault(m => m.UserID == task.UserID);
                                string userName = (member != null && member.User != null) ? member.User.FullName : "Chưa xác định";
                            }
                            <p class="task-responsible">
                                <strong>Người phụ trách:</strong> @userName
                            </p>
                            <p class="task-latecount">
                                <strong>Số lần quá hạn:</strong> @task.LateCount
                            </p>


                            @{
                                var isOverdue = task.EndDate < DateOnly.FromDateTime(DateTime.Now) && task.GroupTaskStatus != "Đã hoàn thành";
                            }
                            <div class="task-actions">
                                @if (ViewBag.IsLeader)
                                {
                                    <form asp-action="Update" method="get" asp-route-id="@task.GroupTaskID">
                                        <button type="submit">Sửa</button>
                                    </form>
                                    <button class="btn-delete" data-task-id="@task.GroupTaskID">Xóa</button>
                                }
                                @if (ViewBag.IsLeader || task.UserID == Context.Session.GetInt32("UserId"))
                                {
                                    <form asp-action="GroupNote" method="get" asp-route-id="@task.GroupTaskID">
                                        <button>Xem ghi chú</button>
                                    </form>
                                }

                                @if (!isOverdue && task.UserID == Context.Session.GetInt32("UserId"))
                                {
                                    <form asp-action="ReportTaskFileList" asp-controller="ReportTaskFile" asp-route-taskid="@task.GroupTaskID">
                                        <button>Báo cáo công việc</button>
                                    </form>
                                }
                                else if (isOverdue && ViewBag.IsLeader)
                                {
                                    <a asp-action="ExtendDeadline" asp-route-id="@task.GroupTaskID" class="btn-ExtendDeadline">Gia hạn</a>
                                }
                                else
                                {
                                    <span class="text-muted">Quá hạn (@task.LateCount lần)</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <a class="btn-back" asp-action="ParentGroupTaskList">Quay lại</a>
            </div>
        </div>
    </div>
</div>




<!-- Thêm jQuery và script AJAX -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $(".btn-delete").click(function () {
            var taskId = $(this).data("task-id");

            if (confirm("Bạn có chắc chắn muốn xóa công việc này?")) {
                $.ajax({
                    url: '@Url.Action("Delete", "GroupTask")', // Đảm bảo đúng action/controller
                    type: 'POST',
                    data: { id: taskId },
                    success: function (response) {
                        if (response.success) {
                            $("#task-card-" + taskId).remove(); // Xóa hàng khỏi bảng
                            alert("Xóa công việc thành công!");
                        } else {
                            alert(response.message || "Xóa công việc thất bại!");
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi trong quá trình xóa.");
                    }
                });
            }
        });

        $(".btn-delete-assignment").click(function () {
            var taskId = $(this).data("task-id");
            var userId = $(this).data("user-id");

            if (confirm("Bạn có chắc chắn muốn xóa thành viên này khỏi công việc?")) {
                $.ajax({
                    url: '@Url.Action("Delete", "TaskAssignment")',
                    type: 'POST',
                    data: { taskId: taskId, userId: userId },
                    success: function (response) {
                        if (response.success) {
                            // Tìm và xóa phần tử có taskId và userId tương ứng
                            $(`.assignment-row[data-task-id='${taskId}'][data-user-id='${userId}']`).remove();
                            alert("Xóa thành viên thành công!");                          
                        } else {
                            alert(response.message || "Xóa thành viên thất bại!");
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi trong quá trình xóa thành viên.");
                    }
                });
            }
        });

        $(".btn-leave").click(function () {
            if (confirm("Bạn có chắc chắn muốn rời khỏi nhóm?")) {

                var groupId = $(this).data("group-id");
                var userId = $(this).data("user-id");

                $.ajax({
                    url: '@Url.Action("LeaveGroup", "GroupMember")',
                    type: 'POST',
                    data: {
                        groupId:groupId,
                        userId: userId
                    },
                    success: function (response) {
                        if (response.success) {
                            // Tìm và xóa phần tử có taskId và userId tương ứng
                            
                            alert("Rời nhóm thành công!");
                            window.location.href = '@Url.Action("GroupList", "Group")';
                        } else {
                            alert(response.errorMessage || "Rời nhóm thất bại!");
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi trong quá trình rời khỏi nhóm.");
                    }
                });
            }
        });

        var currentUserId = @Context.Session.GetInt32("UserId");
        let filters = {
            status: null,
            userOnly: false,
            dueDays: null
        };

        function applyFilters() {
            $(".task-card").hide().filter(function () {
                let card = $(this);
                let status = card.data("status");
                let userId = parseInt(card.data("user-id"));
                let endDateStr = card.data("enddate");
                let endDate = new Date(endDateStr);
                let now = new Date();

                // Điều kiện theo từng filter
                let matchStatus = !filters.status || status === filters.status;
                let matchUser = !filters.userOnly || userId === currentUserId;
                let matchDue = true;

                if (filters.dueDays) {
                    let maxDate = new Date();
                    maxDate.setDate(now.getDate() + filters.dueDays);
                    matchDue = endDate >= now && endDate <= maxDate;
                }

                return matchStatus && matchUser && matchDue;
            }).show();
        }

        $(".btn-filter-status").click(function () {
            let selectedStatus = $(this).data("status");

            if (filters.status === selectedStatus) {
                filters.status = null;
                $(this).removeClass("active");
            } else {
                filters.status = selectedStatus;
                $(".btn-filter-status").removeClass("active");
                $(this).addClass("active");
            }

            applyFilters();
        });

        $("#btn-my-tasks").click(function () {
            filters.userOnly = !filters.userOnly;
            $(this).toggleClass("active");
            applyFilters();
        });

        $("#btn-due-3").click(function () {
            if (filters.dueDays === 3) {
                filters.dueDays = null;
                $(this).removeClass("active");
            } else {
                filters.dueDays = 3;
                $("#btn-due-3").addClass("active");
                $("#btn-due-7").removeClass("active");
            }
            applyFilters();
        });

        $("#btn-due-7").click(function () {
            if (filters.dueDays === 7) {
                filters.dueDays = null;
                $(this).removeClass("active");
            } else {
                filters.dueDays = 7;
                $("#btn-due-7").addClass("active");
                $("#btn-due-3").removeClass("active");
            }
            applyFilters();
        });

        $("#btn-reset").click(function () {
            filters = { status: null, userOnly: false, dueDays: null };
            $(".btn").removeClass("active");
            $(".task-card").show();
        });


    });

    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('filter-toggle-btn');
        const closeBtn = document.getElementById('filter-close-btn');
        const sidebar = document.getElementById('filter-sidebar-wrapper');

        toggleBtn.addEventListener('click', function () {
            sidebar.classList.add('show');
            sidebar.classList.remove('d-none');
        });

        closeBtn.addEventListener('click', function () {
            sidebar.classList.remove('show');
            sidebar.classList.add('d-none');
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('stats-toggle-btn');
        const closeBtn = document.getElementById('stats-close-btn');
        const sidebar = document.getElementById('stats-sidebar-wrapper');

        toggleBtn.addEventListener('click', function () {
            sidebar.classList.add('show');
            sidebar.classList.remove('d-none');
        });

        closeBtn.addEventListener('click', function () {
            sidebar.classList.remove('show');
            sidebar.classList.add('d-none');
        });
    });
</script>

<!-- Chỉnh sửa màu border các thẻ công việc theo độ ưu tiên -->
@functions {
    string GetPriorityClass(string priorityLevel)
    {
        return priorityLevel switch
        {
            "Thấp" => "border-low",
            "Trung bình" => "border-medium",
            "Cao" => "border-high",
            "Khẩn cấp" => "border-critical",
            _ => "border-default"
        };
    }
}

