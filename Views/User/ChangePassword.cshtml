@{
    ViewData["Title"] = "File công việc nhóm";
    ViewData["Description"] = "Danh sách file công việc nhóm giúp bạn quản lý, phân công và theo dõi các file công việc nhóm hiệu quả trong hệ thống quản lý công việc của chúng tôi.";
    ViewData["Keywords"] = "File công việc nhóm, Quản lý file công việc nhóm";
    ViewData["Author"] = "Nhóm 14, Trường Đại học Mở Hà Nội, Lập trình web nâng cao";
    ViewData["Robots"] = "index, follow";

    Layout = "_SimpleLayout";
}

@model WebNC_BTL_QLCV.Models.ChangePasswordViewModel
<link rel="stylesheet" href="~/css/PersonalTask_Create.css" />

<div class="newtasks">
    <h2>Đổi mật khẩu</h2>

    <form asp-action="ChangePassword" method="post" class="changepassForm">
        <div>
            <label>Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" type="password" />
            <br />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>
        <div>
            <label>Mật khẩu mới</label>
            <input asp-for="NewPassword" type="password" />
            <br />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div>
            <label>Xác nhận mật khẩu mới</label>
            <input asp-for="ConfirmPassword" type="password" />
            <br />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <br />
        <button type="submit" class="btn-create">Cập nhật</button>

        @if (ViewBag.SuccessMessage != null)
        {
            <p style="color: green">@ViewBag.SuccessMessage</p>
        }
    </form>

    <a asp-action="Personal_Infor_List" asp-controller="Personal_Information" class="btn-back">Quay lại</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
