@{
    ViewData["Title"] = "File công việc nhóm";
    ViewData["Description"] = "Danh sách file công việc nhóm giúp bạn quản lý, phân công và theo dõi các file công việc nhóm hiệu quả trong hệ thống quản lý công việc của chúng tôi.";
    ViewData["Keywords"] = "File công việc nhóm, Quản lý file công việc nhóm";
    ViewData["Author"] = "Nhóm 14, Trường Đại học Mở Hà Nội, Lập trình web nâng cao";
    ViewData["Robots"] = "index, follow";

    Layout = "_SimpleLayout";
}

@model IEnumerable<WebNC_BTL_QLCV.Models.ReportTaskFile>


<link rel="stylesheet" href="~/css/PersonalNote_List.css" />
<link rel="stylesheet" href="~/css/GroupTaskFile_List.css" />
<link rel="stylesheet" href="~/css/ReportTaskFile_List.css" />

@{
    ViewBag.Title = "Danh sách file báo cáo của công việc nhóm";
    int taskId = ViewBag.TaskId;
}

<!-- <h2>Danh sách file báo cáo cho công việc nhóm (TaskID: @taskId)</h2> -->
<h2>Danh sách file báo cáo cho công việc nhóm</h2>

@if (ViewBag.IsMemberAsign)
{
    <div class="notelist">
        <!-- Form tải file lên cho công việc nhóm -->
        <form asp-action="UploadFile" asp-route-taskid="@taskId" method="post" enctype="multipart/form-data" class="upload-form">
            <div>
                <label for="file">Chọn file để tải lên:</label>
                <br />
                <input type="file" name="file" id="file" required />
            </div>
            <div style="margin-top:10px;">
                <label for="description">Mô tả file:</label><br />
                <textarea name="description" id="description" rows="2" style="width:100%;" placeholder="Nhập mô tả về file..."></textarea>
            </div>
            <button type="submit" class="btn-upload">Tải lên file mới</button>
        </form>
    </div>
}


<div class="notelist">
    <!-- Danh sách file -->
    <table class="table">
        <thead>
            <tr>
                <th>Tên file</th>
                <th>Kích thước</th>
                <th>Loại file</th>
                <th>Người gửi</th>
                <th>Mô tả</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in Model)
            {
                <tr>
                    <td>@file.ReportFileName</td>
                    <td>@Math.Round(file.FileSize, 4) MB</td>
                    <td>@file.FileType</td>
                    <td>@file.SenderName</td>
                    <td>@file.ReportDescription</td>
                    <td>
                        <a class="downloadfile" asp-action="DownloadFile" asp-route-fileId="@file.ReportTaskFileID">Tải xuống</a>
                        <form asp-action="DeleteFile" method="post">
                            <input type="hidden" name="fileId" value="@file.ReportTaskFileID" />
                            <input type="hidden" name="taskId" value="@ViewBag.TaskId" />
                            <button class="delete-note" type="submit" onclick="return confirm('Bạn có chắc muốn xóa file này?');">
                                Xóa
                            </button>
                        </form>
                        <a class="btn-ReportTaskFile" asp-action="FeedbackTaskList" asp-controller="FeedbackTask" asp-route-reportFileId="@file.ReportTaskFileID">
                            Xem phản hồi
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn-back" asp-action="GroupTaskList" asp-controller="GroupTask" asp-route-taskid="">Quay lại</a>
</div>

