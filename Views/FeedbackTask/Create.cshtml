@{
    ViewData["Title"] = "Thêm phản hồi báo cáo Mới";
    ViewData["Description"] = "Thêm công việc mới vào nhóm, giúp bạn phân công công việc và quản lý tiến độ công việc nhóm hiệu quả trong hệ thống quản lý công việc của chúng tôi.";
    ViewData["Keywords"] = "Thêm công việc, Công việc nhóm, Quản lý công việc nhóm, Phân công công việc, Quản lý nhóm, Group tasks, Team management";
    ViewData["Author"] = "Nhóm 14, Trường Đại học Mở Hà Nội, Lập trình web nâng cao";
    ViewData["Robots"] = "noindex, nofollow";

    Layout = "_SimpleLayout";
}

@model WebNC_BTL_QLCV.Models.FeedbackTask

<link rel="stylesheet" href="~/css/PersonalTask_Create.css" />

<div class="newtasks">
    <h2>Tạo phản hồi cho báo cáo</h2>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ReportTaskFileID" />

        <div>
            <label for="FeedbackDetails">Nội dung phản hồi:</label><br />
            <textarea asp-for="FeedbackDetails" rows="4" cols="50"></textarea>
            <span asp-validation-for="FeedbackDetails" class="text-danger"></span>
        </div>

        <button class="btn-create" type="submit">Gửi phản hồi</button>
        <a class="btn-back" asp-action="ReportListByParentTask" asp-controller="ReportTaskFile" asp-route-parentTaskId="@Context.Session.GetInt32("ParentGroupTaskId")">Quay lại danh sách</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
